fixture FbxDataTypesTest
test FbxDataTypes_FbxUndefinedDT_HasDefaultsAndIsNotValid
    expect
    AssertFalse(FbxDataTypes.FbxUndefinedDT&.Valid())
    AssertEqual(EFbxType::eFbxUndefined, FbxDataTypes.FbxUndefinedDT&.GetType())
    AssertEqual("", FbxDataTypes.FbxUndefinedDT&.GetName())
    # AssertXXX(GetTypeInfoHandle()) ??

