    given
    FbxImporter importer = new("")
    importer.Initialize("../samples/monolith&.fbx")

    expect
    AssertEqual(0.0, importer.GetProgress(NULL))

test FbxImporter_GetFileVersion_InitializedYieldsVersionNumbersFromTheFile
    given
    FbxImporter importer = new("")
    int major = 0
    int minor = 0
    int revision = 0
    importer.Initialize("../samples/monolith&.fbx")

    when
#cpp importer.GetFileVersion(major, minor, revision)
#cs importer.GetFileVersion(out major, out minor, out revision)

    then
    AssertEqual(7, major)
    AssertEqual(4, minor)
    AssertEqual(0, revision)

