test FbxImporter_Import_DoubleColonInStringHasOddEncoding
    given
    FbxImporter importer = new("")
    importer.Initialize(GetSample("hierarchy_string_1_7b&.fbx"))
    FbxScene scene = new("")
    bool result

    when
    result = importer.Import(scene)
    then
    AssertTrue(result)
    FbxProperty! prop = scene.GetDocumentInfo().FindProperty("CustomProp")
    AssertEqual("Abc::Def", prop&.Get<FbxString>())
