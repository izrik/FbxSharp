#use constraints

fixture FbxDataTypeTest
test FbxDataType_DefaultConstructor_AttributesSet
    when
    FbxDataType! dt = FbxDataType::Create("int", EFbxType::eFbxInt)
    then
    AssertTrue(dt&.Valid())
    AssertEqual("int", dt&.GetName())
    AssertEqual(EFbxType::eFbxInt, dt&.GetType())

test FbxDataType_OperatorEquals_MatchesSelfButNotIdenticalObjects
    when
    FbxDataType! dt1 = FbxDataType::Create("int", EFbxType::eFbxInt)
    FbxDataType! dt2 = FbxDataType::Create("int", EFbxType::eFbxInt)

    then
    AssertTrue(dt1&.Valid())
    AssertTrue(dt2&.Valid())
    AssertEqual(dt1&.GetName(), dt2&.GetName())
    AssertEqual(dt1&.GetType(), dt2&.GetType())
    AssertEqual(dt1, dt1)
    AssertEqual(dt1, dt1)
    AssertTrue(dt1 == dt1)
    AssertTrue(dt2 == dt2)
    AssertFalse(dt1 != dt1)
    AssertFalse(dt2 != dt2)
    AssertNotEqual(FbxDataTypes.FbxIntDT, dt1)
    AssertNotEqual(FbxDataTypes.FbxIntDT, dt2)
    AssertFalse(FbxDataTypes.FbxIntDT == dt1)
    AssertFalse(FbxDataTypes.FbxIntDT == dt2)
    AssertTrue(FbxDataTypes.FbxIntDT != dt1)
    AssertTrue(FbxDataTypes.FbxIntDT != dt2)
    AssertNotEqual(dt1, dt2)
    AssertFalse(dt1 == dt2)
    AssertTrue(dt1 != dt2)

test FbxDataType_FbxGetDataTypeFromEnum_YieldsCorrectDataType
    expect
    AssertEqual(FbxDataTypes.FbxUndefinedDT, FbxDataType.FbxGetDataTypeFromEnum(EFbxType::eFbxUndefined))
    AssertEqual(FbxDataTypes.FbxCharDT, FbxDataType.FbxGetDataTypeFromEnum(EFbxType::eFbxChar))
    AssertEqual(FbxDataTypes.FbxUCharDT, FbxDataType.FbxGetDataTypeFromEnum(EFbxType::eFbxUChar))
    AssertEqual(FbxDataTypes.FbxShortDT, FbxDataType.FbxGetDataTypeFromEnum(EFbxType::eFbxShort))
    AssertEqual(FbxDataTypes.FbxUShortDT, FbxDataType.FbxGetDataTypeFromEnum(EFbxType::eFbxUShort))
    AssertEqual(FbxDataTypes.FbxUIntDT, FbxDataType.FbxGetDataTypeFromEnum(EFbxType::eFbxUInt))
    AssertEqual(FbxDataTypes.FbxLongLongDT, FbxDataType.FbxGetDataTypeFromEnum(EFbxType::eFbxLongLong))
    AssertEqual(FbxDataTypes.FbxULongLongDT, FbxDataType.FbxGetDataTypeFromEnum(EFbxType::eFbxULongLong))
    AssertEqual(FbxDataTypes.FbxHalfFloatDT, FbxDataType.FbxGetDataTypeFromEnum(EFbxType::eFbxHalfFloat))
    AssertEqual(FbxDataTypes.FbxBoolDT, FbxDataType.FbxGetDataTypeFromEnum(EFbxType::eFbxBool))
    AssertEqual(FbxDataTypes.FbxIntDT, FbxDataType.FbxGetDataTypeFromEnum(EFbxType::eFbxInt))
    AssertEqual(FbxDataTypes.FbxFloatDT, FbxDataType.FbxGetDataTypeFromEnum(EFbxType::eFbxFloat))
    AssertEqual(FbxDataTypes.FbxDoubleDT, FbxDataType.FbxGetDataTypeFromEnum(EFbxType::eFbxDouble))
    AssertEqual(FbxDataTypes.FbxDouble2DT, FbxDataType.FbxGetDataTypeFromEnum(EFbxType::eFbxDouble2))
    AssertEqual(FbxDataTypes.FbxDouble3DT, FbxDataType.FbxGetDataTypeFromEnum(EFbxType::eFbxDouble3))
    AssertEqual(FbxDataTypes.FbxDouble4DT, FbxDataType.FbxGetDataTypeFromEnum(EFbxType::eFbxDouble4))
    AssertEqual(FbxDataTypes.FbxDouble4x4DT, FbxDataType.FbxGetDataTypeFromEnum(EFbxType::eFbxDouble4x4))
    AssertEqual(FbxDataTypes.FbxEnumDT, FbxDataType.FbxGetDataTypeFromEnum(EFbxType::eFbxEnum))
    AssertEqual(FbxDataTypes.FbxEnumDT, FbxDataType.FbxGetDataTypeFromEnum(EFbxType::eFbxEnumM))
    AssertEqual(FbxDataTypes.FbxStringDT, FbxDataType.FbxGetDataTypeFromEnum(EFbxType::eFbxString))
    AssertEqual(FbxDataTypes.FbxTimeDT, FbxDataType.FbxGetDataTypeFromEnum(EFbxType::eFbxTime))
    AssertEqual(FbxDataTypes.FbxReferenceDT, FbxDataType.FbxGetDataTypeFromEnum(EFbxType::eFbxReference))
    AssertEqual(FbxDataTypes.FbxBlobDT, FbxDataType.FbxGetDataTypeFromEnum(EFbxType::eFbxBlob))
    AssertEqual(FbxDataTypes.FbxDistanceDT, FbxDataType.FbxGetDataTypeFromEnum(EFbxType::eFbxDistance))
    AssertEqual(FbxDataTypes.FbxDateTimeDT, FbxDataType.FbxGetDataTypeFromEnum(EFbxType::eFbxDateTime))
